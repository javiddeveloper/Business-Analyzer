# این فایل را کپی کن به secrets.env و مقادیر واقعی را بگذار.
# cp secrets.env.example secrets.env
# راحت‌تر: از پنل تنظیمات (⚙) در داشبورد (http://localhost:8078/admin) استفاده کن — همین مقادیر را بدون
# ویرایش دستی فایل تنظیم می‌کند.

# ---- پروژه‌ی محلی (الزامی) ----
# مسیر کامل پوشه‌ی پروژه روی همین سیستم که از قبل با git clone گرفته شده.
# بدون این، هیچ ریویویی اجرا نمی‌شود.
PROJECT_PATH=

# ---- GitLab ----
GITLAB_URL=https://gitlab.com
# Access Token (Project یا Personal) با اسکوپ api
GITLAB_TOKEN=your_gitlab_access_token
# رشته‌ی دلخواه — همین مقدار را موقع ساخت Webhook در گیت‌لب هم به عنوان Secret Token بگذار
WEBHOOK_SECRET=choose_a_random_secret_string
# اختیاری: اگر پر شود، داشبورد و ریویوی خودکار فقط MRهای همین پروژه را می‌بینند
# (خالی = همه‌ی MRهای بازی که توکن به آن‌ها دسترسی دارد). شناسه‌ی عددی یا group/project
GITLAB_PROJECT_ID=

# ---- AI Provider ----
# claude-cli | openai-compatible | 9router | gemini
# هر موتور کلید/آدرس/مدل جدای خودش را دارد، پس از نوار بالای داشبورد
# (دکمه‌ی «مدل») می‌توانی بین موتورهای از قبل تنظیم‌شده سریع جابه‌جا شوی
# بدون این‌که تنظیمات موتور دیگر پاک شود.
AI_PROVIDER=openai-compatible

# claude-cli یعنی اجرای مستقیم دستور claude (Claude Code CLI) روی همین سیستم —
# با اشتراک/لاگین خودت، بدون نیاز به کلید API. باید از قبل نصب و login شده باشد:
#   npm install -g @anthropic-ai/claude-code && claude login
CLAUDE_MODEL=

# openai-compatible (GapGPT / OpenAI / پروکسی محلی)
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.gapgpt.app/v1

# 9router — روتر چندمدله؛ کلید/آدرس/مدل جدا از openai-compatible
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_MODEL=combo

# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Admin UI (پایگاه دانش) ----
# اگر خالی بماند و سرور فقط از همان دستگاه (localhost) صدا زده شود، نیازی به توکن نیست.
# برای دسترسی از دستگاه/شبکه‌ی دیگر، یک مقدار بگذار و همان را در هدر X-Admin-Token بفرست.
ADMIN_TOKEN=

# ---- سقف حجم context (اختیاری) ----
# هر موتور پنجره‌ی context واقعی خودش را دارد و lib/contextBudget.js همه‌ی سقف‌ها
# (حجم هر دسته، متن کامل فایل، پایگاه دانش، شرح تسک جیرا) را از روی همان می‌سازد.
# پیش‌فرض‌ها: claude-cli ۲۰۰۰۰۰، openai-compatible ۱۲۸۰۰۰، 9router ۳۲۰۰۰، gemini ۱۰۰۰۰۰۰ توکن.
# این دو مقدار، پیش‌فرضِ موتور فعال را بازنویسی می‌کنند (خالی = همان پیش‌فرض):
REVIEW_CONTEXT_TOKENS=
REVIEW_MAX_OUTPUT_TOKENS=
# و اگر فقط یک موتور خاص را می‌خواهی تنظیم کنی (اولویت با این‌هاست):
#   CLAUDE_CONTEXT_TOKENS / CLAUDE_MAX_OUTPUT_TOKENS
#   AI_CONTEXT_TOKENS / AI_MAX_OUTPUT_TOKENS
#   NINEROUTER_CONTEXT_TOKENS / NINEROUTER_MAX_OUTPUT_TOKENS
#   GEMINI_CONTEXT_TOKENS / GEMINI_MAX_OUTPUT_TOKENS
